{
  "version": 2,
  "builds": [
    { "src": "src/serve.ts", "use": "@vercel/node" },
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/src/serve.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
